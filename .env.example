# Postgres (compose.dev.yml exposes this)
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas
# Under docker/compose.yml use the db service instead:
# DATABASE_URL=postgres://atlas:atlas@db:5432/atlas
# 32+ random chars. Generate: openssl rand -hex 32 . The app refuses this example value in production.
COOKIE_SECRET=change-me-change-me-change-me-change-me
# Any OpenAI-compatible endpoint. Leave LLM_API_KEY empty to run on the local fallback.
LLM_BASE_URL=https://api.ifm.ai/v1
LLM_MODEL=IFM/K2-Horizon-375B-A23B
LLM_API_KEY=
LLM_REASONING_EFFORT=
RATE_LIMIT_PER_HOUR=60
# Optional self-hosted Umami analytics (cookie-less). Set both or leave both empty (no tracker, no CSP change).
# UMAMI_SCRIPT_URL is the tracker script on your Umami server (https in production), e.g. https://stats.example.com/script.js
# UMAMI_WEBSITE_ID is the website's UUID from the Umami dashboard.
# UMAMI_DOMAINS (optional) limits counting to these comma-separated host names, e.g. agentmind.zaqi.build
# An invalid value turns analytics off with one warning in the log; the app keeps working.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
UMAMI_DOMAINS=
# Production only (Caddy)
DOMAIN=agentmind.zaqi.build
